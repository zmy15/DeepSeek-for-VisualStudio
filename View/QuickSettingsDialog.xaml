<Window x:Class="DeepSeek_v4_for_VisualStudio.View.QuickSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Settings"
        Width="760"
        Height="700"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1F1F1F"
        Foreground="#D4D4D4">
    <Window.Resources>
        <SolidColorBrush x:Key="QuickComboBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="QuickComboBorder" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="QuickComboHover" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="QuickComboPopup" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="QuickComboSelection" Color="#264F78"/>
        <SolidColorBrush x:Key="QuickComboArrow" Color="#A8A8A8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
        </Style>

        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFAFAF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource QuickComboBackground}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource QuickComboBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          SnapsToDevicePixels="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="7,3,0,3"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="{DynamicResource QuickComboArrow}"
                                                      StrokeThickness="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource QuickComboHover}"/>
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource QuickComboBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,25,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   SnapsToDevicePixels="True">
                                <Border Background="{DynamicResource QuickComboPopup}"
                                        BorderBrush="{DynamicResource QuickComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4,5">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource QuickComboPopup}"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource QuickComboHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource QuickComboSelection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2D5A8C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D5A8C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4FC1FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleLabel"
                       Text="Quick Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#F5F5F5"/>
            <TextBlock x:Name="SubtitleLabel"
                       Text="Common options for chat, models and editor behavior."
                       Margin="0,4,0,0"
                       Foreground="#8C8C8C"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Connection -->
                <Border BorderBrush="#343434"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ConnectionSectionLabel"
                                       Text="Connection"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ConnectionHintLabel"
                                       Text="Connect the chat to the DeepSeek API."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ApiKeyLabel"
                                           Text="API key"
                                           Style="{StaticResource FieldLabel}"/>
                                <PasswordBox Grid.Column="1"
                                             x:Name="ApiKeyPasswordBox"
                                             PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>
                            </Grid>
                            <Grid Margin="122,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           x:Name="ApiKeyStatusLabel"
                                           Text="Not configured"
                                           Foreground="#C586C0"
                                           FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="ApiKeyHintLabel"
                                           Text="Stored in Visual Studio Credential Storage."
                                           Foreground="#777777"
                                           FontSize="11"
                                           Margin="12,0,0,0"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        x:Name="GetApiKeyButton"
                                        Content="Get API key"
                                        Style="{StaticResource LinkButton}"
                                        Click="GetApiKeyButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Model -->
                <Border BorderBrush="#343434"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ModelSectionLabel"
                                       Text="Model"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ModelHintLabel"
                                       Text="Choose the default model and reasoning budget."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ModelLabel"
                                           Text="Model"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="ModelComboBox"
                                          SelectionChanged="ModelComboBox_SelectionChanged"/>
                                <Button Grid.Column="2"
                                        x:Name="OpenModelSettingsButton"
                                        Content="Model Settings..."
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        Click="OpenModelSettingsButton_Click"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          x:Name="ThinkingCheckBox"
                                          Content="Deep thinking"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="ReasoningLabel"
                                           Text="Reasoning"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="22,0,8,0"/>
                                <ComboBox Grid.Column="2"
                                          x:Name="EffortComboBox"
                                          Width="120"
                                          HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tools -->
                <Border BorderBrush="#343434"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ToolsSectionLabel"
                                       Text="Tools"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ToolsHintLabel"
                                       Text="Control web access and command approvals."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           x:Name="WebSearchLabel"
                                           Text="Web search"
                                           Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox x:Name="WebSearchCheckBox"
                                              Content="Enable"
                                              Checked="WebSearchCheckBox_CheckedChanged"
                                              Unchecked="WebSearchCheckBox_CheckedChanged"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                                    <ComboBox x:Name="SearchProviderComboBox"
                                              MinWidth="150"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ApprovalLabel"
                                           Text="Approval mode"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="ApprovalModeComboBox"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="McpLabel"
                                           Text="MCP servers"
                                           Style="{StaticResource FieldLabel}"/>
                                <Button Grid.Column="1"
                                        x:Name="OpenMcpSettingsButton"
                                        Content="Manage MCP Servers…"
                                        HorizontalAlignment="Left"
                                        Padding="10,4"
                                        Click="OpenMcpSettingsButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- OCR -->
                <Border x:Name="OcrSection"
                        BorderBrush="#343434"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="OcrSectionLabel"
                                       Text="OCR"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="OcrHintLabel"
                                       Text="Used when the selected model cannot read images directly."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OcrEngineLabel"
                                           Text="OCR engine"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="OcrEngineComboBox"
                                          SelectionChanged="OcrEngineComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid x:Name="OcrPurposeRow"
                                  Margin="0,10,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OcrPurposeLabel"
                                           Text="Official OCR mode"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="OcrPurposeComboBox"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Appearance -->
                <Border BorderBrush="#343434"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="AppearanceSectionLabel"
                                       Text="Appearance"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="AppearanceHintLabel"
                                       Text="Set the language and color theme."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel"
                                           Text="Language"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="LanguageComboBox"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ThemeLabel"
                                           Text="Theme"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="ThemeComboBox"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editor -->
                <Border BorderBrush="#343434"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="EditorSectionLabel"
                                       Text="Editor"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="EditorHintLabel"
                                       Text="Editor integrations outside the chat panel."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical">
                            <CheckBox x:Name="AutoCompleteCheckBox"
                                      Content="Enable code completion"/>
                            <CheckBox x:Name="DiffMarkersCheckBox"
                                      Content="Show diff markers in the editor"
                                      Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#252526"
                        BorderBrush="#343434"
                        BorderThickness="1"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AdvancedHintLabel"
                                   Grid.Column="0"
                                   Text="Custom endpoints, context limits, OCR, Agent limits and diagnostics remain in the original options page."
                                   Foreground="#8C8C8C"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Grid.Column="1"
                                x:Name="AdvancedSettingsButton"
                                Content="Advanced Settings"
                                Click="AdvancedSettingsButton_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="SaveHintLabel"
                       Text="Changes apply when you click Save."
                       Foreground="#777777"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
